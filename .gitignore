# Geheimnisse — niemals ins Repository
.env
.env.*
*.key
*.pem
.suno-state.json
# Auch jede Sicherung davon. Der Rat "vor jedem Lauf eine Kopie anlegen"
# (Issue #199) erzeugt Dateien mit denselben Sitzungs-Cookies — gemessen:
# 39 Stueck in einer .bak, und sie war NICHT ignoriert.
.suno-state.json.*
*.suno-state.json*

# Abhängigkeiten und Bau-Ergebnisse
node_modules
dist/
.vite/
venv/
__pycache__/
*.pyc

# Rust (Simulator)
# Das Bau-Verzeichnis liegt im Wurzelverzeichnis, weil dort der Cargo-Workspace
# definiert ist (siehe Cargo.toml) — nur so bekommt der Remote-Bau data/ zu sehen.
/target/
sim/target/

# Klang-Rohdaten und Kandidaten der Werkzeugkette.
#
# Was das Spiel braucht, liegt in assets/audio/ und ist versioniert. Unter
# assets/sfx/ sammeln sich dagegen Suno-Rohdateien, beide Entwuerfe je Klang
# und die Zwischenstaende der Erprobungslaeufe — zusammen zweistellige
# Megabyte an MP3, die niemand aus dem Repository braucht. Lokal bleiben sie
# liegen: Damit laesst sich jederzeit auf den zweiten Entwurf umstellen
# (tools/sfx-post.sh <raw> <out> b), ohne neue Credits zu verbrauchen.
assets/sfx/

# Sitzungseigene Claude-Einstellungen.
#
# .claude/settings.json ist versioniert und gilt fuer ALLE vier Sitzungen —
# auch fuer die drei Worktrees, die dieselbe Datei aus git bekommen. Ein Hook,
# der nur zu einer Rolle passt, gehoert deshalb hierher und nicht dorthin:
# der Orchestrator braucht beim Verdichten seinen Nachrichtenstand, ein Worker
# nicht. Am 2026-07-29 hat ein Hook, der eine Ebene zu weit oben stand, fremde
# Sitzungen blockiert.
.claude/settings.local.json

# Werkzeug-Ausgaben
.playwright-cli/
*.log
llm-*.md

# Datenbanken und lokale Zwischenstände
*.db
*.sqlite

# Betriebssystem
.DS_Store
Thumbs.db


# Generiert beim Entwicklungs-Bau der Pruefblaetter
docs/archive-check/preview.js

docs/training-check/preview.js
