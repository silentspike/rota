{
  "name": "rota",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ROTA — Spell-Rotation-DPS-Game im Browser",
  "scripts": {
    "dev": "vite",
    "predev": "bash tools/fenster-warnung.sh",
    "build": "tsc --noEmit && vite build",
    "prebuild": "bash tools/fenster-warnung.sh",
    "preview": "vite preview",
    "prepreview": "bash tools/fenster-warnung.sh",
    "soundboard": "vite build --mode development && echo '\\nAbhoer-Soundboard: http://localhost:8000/rota/soundboard.html'",
    "presoundboard": "bash tools/fenster-warnung.sh",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "bash tools/fenster-warnung.sh",
    "lint": "eslint . && prettier --check .",
    "prelint": "bash tools/fenster-warnung.sh",
    "format": "prettier --write .",
    "preformat": "bash tools/fenster-warnung.sh",
    "test": "vitest run",
    "pretest": "bash tools/fenster-warnung.sh",
    "test:watch": "vitest",
    "pretest:watch": "bash tools/fenster-warnung.sh",
    "test:parity": "vitest run tests/parity",
    "pretest:parity": "bash tools/fenster-warnung.sh",
    "parity:export": "vite-node tests/parity/export-parity.mjs",
    "preparity:export": "bash tools/fenster-warnung.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-node": "6.0.0",
    "vitest": "^4.1.11"
  }
}
