{
  "name": "rota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ROTA — Spell-Rotation-DPS-Game im Browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "soundboard": "vite build --mode development && echo '\\nAbhoer-Soundboard: http://localhost:8000/rota/soundboard.html'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "parity:export": "vite-node tests/parity/export-parity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-node": "6.0.0",
    "vitest": "^4.1.10"
  }
}
